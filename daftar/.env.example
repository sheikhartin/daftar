# ---------------------------------------------------------------------------
# Daftar environment variables. Copy this file to `.env` and adjust it.
#   cp daftar/.env.example .env
# NEVER commit the real `.env` file. NEVER reuse the secret keys below.
# ---------------------------------------------------------------------------

# Turn this OFF (0) in production.
DEBUG=1

# Hosts allowed to serve the site. For a real domain use:
#   ALLOWED_HOSTS=daftar.example.com www.daftar.example.com
ALLOWED_HOSTS=127.0.0.1 localhost

# Generate a strong secret key with:
#   poetry run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-generate-a-new-one

# Database. For local tests or a quick start use:
#   DB_ENGINE=sqlite
# For PostgreSQL (production) either set the individual values below or use
# a single DATABASE_URL (which wins when both are present), e.g.:
#   DATABASE_URL=postgres://user:password@host:5432/daftar
DB_ENGINE=postgresql
DB_NAME=portfolio_db
DB_USER=root
DB_PASSWORD=toor
DB_HOST=localhost
DB_PORT=5432

# --- Production security (the defaults below are already secure) ------------
# Redirect HTTP to HTTPS. Set to 1 when serving over TLS.
# SECURE_SSL_REDIRECT=1
# Only if the site is behind a trusted TLS-terminating proxy (nginx, ...):
# TRUST_FORWARDED_HEADERS=1
# Required by Django's CSRF protection when served via a custom domain:
# CSRF_TRUSTED_ORIGINS=https://daftar.example.com
# SESSION_COOKIE_SECURE=1
# CSRF_COOKIE_SECURE=1

# --- Comment anti-spam -------------------------------------------------------
# Maximum comments per IP per window (0 disables the limiter).
# COMMENT_RATE_LIMIT=3
# COMMENT_RATE_WINDOW_SECONDS=600
